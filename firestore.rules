rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function memberPath(uid) { return /databases/$(database)/documents/members/$(uid); }
    function settingsPath() { return /databases/$(database)/documents/system/club; }
    function groupInfoPath() { return /databases/$(database)/documents/system/groupInfo; }
    function myMember() { return get(memberPath(request.auth.uid)).data; }
    function activeMember() {
      return signedIn() && exists(memberPath(request.auth.uid)) && myMember().status == 'active';
    }
    function isAdmin() { return activeMember() && myMember().role == 'admin'; }
    function validProfile(data) {
      return data.keys().hasOnly(['uid', 'username', 'nickname', 'avatar', 'avatarPhoto', 'createdAt'])
        && data.uid == request.auth.uid
        && data.username is string && data.username.size() >= 3 && data.username.size() <= 16
        && data.nickname is string && data.nickname.size() >= 2 && data.nickname.size() <= 20
        && data.avatar is string && data.avatar.size() <= 8
        && (!('avatarPhoto' in data) || (data.avatarPhoto is string
          && data.avatarPhoto.size() <= 20000
          && data.avatarPhoto.matches('data:image/jpeg;base64,[A-Za-z0-9+/=]+')));
    }

    match /system/club {
      allow get: if isAdmin() || activeMember();
      allow list: if false;
      allow create: if false;
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['inviteHash', 'groupName']);
      allow delete: if false;
    }

    match /system/groupInfo {
      allow get: if signedIn();
      allow list: if false;
      allow create: if false;
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['groupName']);
      allow delete: if false;
    }

    match /members/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create: if false;
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'status', 'chatMuted', 'uploadsDisabled'])
        && request.resource.data.role in ['admin', 'member']
        && request.resource.data.status in ['active', 'removed']
        && request.resource.data.chatMuted is bool
        && request.resource.data.uploadsDisabled is bool;
      allow delete: if isAdmin() && uid != request.auth.uid;
    }

    match /profiles/{uid} {
      allow get, list: if activeMember();
      allow create: if false;
      allow update: if activeMember() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nickname', 'avatar', 'avatarPhoto'])
        && validProfile(request.resource.data);
      allow delete: if isAdmin() && uid != request.auth.uid;
    }

    match /invites/{hash} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && request.resource.data.active == true
        && request.resource.data.createdBy == request.auth.uid
        && isAdmin();
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active']);
      allow delete: if isAdmin();
    }

    match /chat/{messageId} {
      allow read: if activeMember();
      allow create: if activeMember() && myMember().chatMuted == false
        && request.resource.data.keys().hasOnly(['uid', 'nickname', 'avatar', 'text', 'createdAt', 'admin'])
        && request.resource.data.uid == request.auth.uid
        && (!('admin' in request.resource.data) || request.resource.data.admin == isAdmin())
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 350;
      allow update, delete: if isAdmin();
    }

    function twoDigits(value) {
      return (value < 10 ? '0' : '') + string(value);
    }
    function starDay() {
      let india = request.time + duration.value(19800, 's');
      return string(india.year()) + '-' + twoDigits(india.month()) + '-' + twoDigits(india.day());
    }
    function rewardTotal(claims) {
      return (claims.get('trivia', false) == true ? 5 : 0)
        + (claims.get('kindness', false) == true ? 3 : 0)
        + (claims.get('math', false) == true ? 4 : 0)
        + (claims.get('choice', false) == true ? 2 : 0)
        + (claims.get('puzzle', false) == true ? 3 : 0);
    }
    function validReward(uid, prior) {
      let next = request.resource.data;
      let claims = next.daily;
      let old = prior.get('day', '') == starDay() ? prior.get('daily', {}) : {};
      let delta = claims.diff(old);
      return next.keys().hasOnly(['uid', 'points', 'updatedAt', 'day', 'daily'])
        && next.uid == uid && next.day == starDay() && next.updatedAt == request.time
        && next.points is int && claims is map
        && claims.keys().hasOnly(['trivia', 'kindness', 'math', 'choice', 'puzzle'])
        && claims.get('trivia', true) == true && claims.get('kindness', true) == true
        && claims.get('math', true) == true && claims.get('choice', true) == true
        && claims.get('puzzle', true) == true
        && delta.addedKeys().size() == 1
        && delta.changedKeys().size() == 0 && delta.removedKeys().size() == 0
        && next.points == prior.get('points', 0) + rewardTotal(claims) - rewardTotal(old);
    }
    match /scores/{uid} {
      allow read: if activeMember();
      allow create: if activeMember() && request.auth.uid == uid && validReward(uid, {});
      allow update: if activeMember() && request.auth.uid == uid && validReward(uid, resource.data);
      allow delete: if isAdmin();
    }

    // Monday midnight and Sunday voting, India time.
    function elapsed() { return (request.time.toMillis() + 279000000) % 604800000; }
    function weekStart() { return request.time.toMillis() - elapsed(); }
    function sunday() { return elapsed() >= 518400000; }
    function artPath(id) { return /databases/$(database)/documents/weeklyArt/$(id); }
    function slotPath(uid) { return /databases/$(database)/documents/artSlots/$(uid); }
    function isCurrentArt(data) { return data.week == weekStart(); }
    function legacyArtExists(uid) {
      let path = slotPath(uid);
      return exists(path) && get(path).data.week == weekStart()
        && exists(artPath(get(path).data.art));
    }
    function ballotChange(id, before) {
      let data = request.resource.data;
      let diff = data.choices.diff(before);
      return data.keys().hasOnly(['uid', 'week', 'choices', 'target']) && data.uid == request.auth.uid
        && data.week == weekStart() && id == request.auth.uid + '_' + string(data.week)
        && data.choices is map && data.choices.size() <= 10 && data.target is string
        && data.target.matches('[A-Za-z0-9_-]{1,140}')
        && diff.affectedKeys().size() == 1 && diff.affectedKeys().hasOnly([data.target])
        && (diff.removedKeys().size() == 1 || (
          diff.addedKeys().size() == 1 && data.choices[data.target] == true
          && get(artPath(data.target)).data.week == weekStart()
          && get(artPath(data.target)).data.uid != request.auth.uid
        ));
    }
    match /drawings/{id} {
      allow read: if activeMember();
      allow delete: if isAdmin();
    }
    match /artSlots/{uid} {
      allow get: if activeMember() && request.auth.uid == uid;
    }
    match /weeklyArt/{id} {
      allow read: if activeMember();
      allow create: if activeMember() && !sunday() && !myMember().uploadsDisabled
        && request.resource.data.keys().hasOnly(['uid', 'nickname', 'strokes', 'week', 'slot'])
        && request.resource.data.uid == request.auth.uid
        && isCurrentArt(request.resource.data)
        && request.resource.data.slot is int && request.resource.data.slot >= 0 && request.resource.data.slot < 5
        && id == request.auth.uid + '_' + string(weekStart()) + '_' + string(request.resource.data.slot)
        && (request.resource.data.slot != 0 || !legacyArtExists(request.auth.uid))
        && request.resource.data.nickname == get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.nickname
        && request.resource.data.strokes is string && request.resource.data.strokes.size() <= 800000;
      allow delete: if activeMember() && isCurrentArt(resource.data)
        && (isAdmin() || (!sunday() && resource.data.uid == request.auth.uid));
    }
    match /artVotes/{uid} {
      allow read: if activeMember();
    }
    match /weeklyBallots/{id} {
      allow get: if activeMember() && id == request.auth.uid + '_' + string(weekStart());
      allow create: if activeMember() && sunday() && ballotChange(id, {});
      allow update: if activeMember() && sunday() && ballotChange(id, resource.data.choices);
    }
    match /artResults/{week} {
      allow get: if activeMember();
    }
    match /clubJoinAttempts/{source} {
      allow read, write: if false;
    }
    match /pinResets/{username} {
      allow read, write: if false;
    }
    match /teamPolls/{id} {
      allow read: if activeMember();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['question', 'first', 'second', 'createdAt'])
        && request.resource.data.createdAt == request.time
        && request.resource.data.question is string && request.resource.data.question.size() > 0
        && request.resource.data.question.size() <= 100
        && request.resource.data.first is string && request.resource.data.first.size() > 0
        && request.resource.data.first.size() <= 40
        && request.resource.data.second is string && request.resource.data.second.size() > 0
        && request.resource.data.second.size() <= 40 && request.resource.data.first != request.resource.data.second;
      match /answers/{uid} {
        allow read: if activeMember();
        allow create, update: if activeMember() && request.auth.uid == uid
          && exists(/databases/$(database)/documents/teamPolls/$(id))
          && request.resource.data.keys().hasOnly(['option'])
          && request.resource.data.option is int && request.resource.data.option in [0, 1];
      }
    }
  }
}



